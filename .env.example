# ──────────────────────────────────────────────
# Internal LLM RAG Service — Environment Config
# ──────────────────────────────────────────────

# ── Application ──
APP_NAME=Internal_LLM_RAG_service
APP_HOST=0.0.0.0
APP_PORT=8080
APP_WORKERS=8
DEBUG=false
LOG_LEVEL=info

# ── Authentication ──
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ADMIN_API_KEY=sk-admin-change-me

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llm_platform
POSTGRES_USER=llm_admin
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://llm_admin:change-me-strong-password@localhost:5432/llm_platform

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=8gb
REDIS_MESSAGE_TTL=86400
REDIS_SUMMARY_TTL=3600

# ── Qdrant Vector DB ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
EMBEDDING_DIMENSION=1024

# ── LiteLLM Proxy ──
LITELLM_HOST=localhost
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-master-change-me

# ── LLM HTTP client tuning ──
# Retries are owned by LiteLLM's num_retries, NOT by the SDK. The app sets
# max_retries=0 so the two layers cannot multiply into a dozen attempts at a
# 30k-token prefill. See app/services/llm_client.py.
LLM_REQUEST_TIMEOUT=600.0
LLM_CONNECT_TIMEOUT=5.0
LLM_MAX_CONNECTIONS=1000
LLM_MAX_KEEPALIVE_CONNECTIONS=200

# ── Observability ──
# Prometheus is published on 9091; host port 9090 is reserved for the llm-d
# endpoint picker's metrics endpoint.
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# ── LLM Endpoints (vLLM) ──
VLLM_CHAT_HOST=localhost
VLLM_CHAT_PORT=8000
VLLM_CHAT_API_KEY=vllm-internal-key
VLLM_CHAT_MODEL=amd/Llama-3.1-405B-Instruct-MXFP4

VLLM_CODE_HOST=localhost
VLLM_CODE_PORT=8001
VLLM_CODE_API_KEY=vllm-internal-key
VLLM_CODE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

VLLM_EMBED_HOST=localhost
VLLM_EMBED_PORT=8002
VLLM_EMBED_API_KEY=vllm-internal-key
VLLM_EMBED_MODEL=BAAI/bge-large-en-v1.5

# ── Model Aliases (maps OpenAI model names → vLLM) ──
# OpenAI-shaped names for SELF-HOSTED models; no OpenAI model is ever called.
#   gpt-4 / gpt-4-turbo / gpt-4o -> Llama 3.1 405B Instruct (MXFP4)
#   gpt-3.5-turbo                -> Qwen 2.5 Coder 32B  (a CODE model)
#   text-embedding-*             -> BGE-large-en-v1.5
CHAT_MODEL_ALIAS=gpt-4
CODE_MODEL_ALIAS=gpt-3.5-turbo
EMBED_MODEL_ALIAS=text-embedding-ada-002

# Additional chat-capable aliases accepted on agents.model, beyond
# CHAT_MODEL_ALIAS and CODE_MODEL_ALIAS. Embedding aliases are excluded —
# an agent cannot converse with an embedding model.
# MUST stay in sync with the model_list in litellm_config.yaml.
EXTRA_AGENT_MODEL_ALIASES=gpt-4-turbo,gpt-4o

# ── GPU Configuration ──
# Tensor-parallel size must divide Llama 3.1 405B's 128 attention heads,
# 8 KV heads AND intermediate_size 53248. Only TP in {2, 4, 8} is valid —
# TP=6 fails on two of the three and the server will not start.
#
# Production chat layout is 3 replicas at TP=2 (scripts/start_vllm_sharded.sh):
#   replica 0 -> GPUs 0,1 : 8000
#   replica 1 -> GPUs 2,3 : 8010
#   replica 2 -> GPUs 4,5 : 8020
# The single-replica fallback (scripts/start_vllm.sh) is TP=4 on GPUs 0-3.
TOTAL_GPUS=8
CHAT_GPU_IDS=0,1,2,3,4,5
CHAT_REPLICA_GPU_PAIRS=0,1;2,3;4,5
CHAT_REPLICA_PORTS=8000,8010,8020
CODE_GPU_IDS=6
EMBED_GPU_IDS=7
CHAT_TENSOR_PARALLEL=2

# ── Context Management ──
DEFAULT_MAX_CONTEXT_TOKENS=16384
RESERVED_RESPONSE_TOKENS=4096
RAG_CHUNK_TOKEN_BUDGET=3000
SUMMARY_THRESHOLD_MESSAGES=50

# ── Document Ingestion ──
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_BATCH_SIZE=64
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,html

# ── Rate Limits (per user) ──
DEFAULT_RPM=60
DEFAULT_TPM=200000

# ── Model Storage ──
MODEL_STORAGE_PATH=/models
